{
  "openapi": "3.1.0",
  "info": {
    "title": "REGULEX Public Library API",
    "version": "1.0.0",
    "summary": "Read-only access to REGULEX public publications on UAE law and its service pages.",
    "description": "General public information from REGULEX Legal Consultancy. Not legal advice; verify rules against current official sources. Publication endpoints need no authentication and contain no client data. To read a publication as Markdown, request its url with Accept: text/markdown. POST /api/v1/inquiries sends an enquiry on behalf of a person who approved it on regulex-legal.com (OAuth, scope inquiries:write); see https://regulex-legal.com/auth.md.",
    "contact": {
      "name": "REGULEX Legal Consultancy",
      "email": "info@regulex-legal.com",
      "url": "https://regulex-legal.com"
    }
  },
  "servers": [
    {
      "url": "https://regulex-legal.com"
    }
  ],
  "paths": {
    "/api/v1/articles.json": {
      "get": {
        "operationId": "listPublications",
        "summary": "List all public articles and newsletter issues, newest first",
        "responses": {
          "200": {
            "description": "Publication index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationIndex"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/services.json": {
      "get": {
        "operationId": "listServices",
        "summary": "List REGULEX service pages and public contact channels",
        "responses": {
          "200": {
            "description": "Service index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceIndex"
                }
              }
            }
          }
        }
      }
    },
    "/api/health.json": {
      "get": {
        "operationId": "getStatus",
        "summary": "API status",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inquiries": {
      "post": {
        "operationId": "sendInquiry",
        "summary": "Send an enquiry to REGULEX for the person who authorized the token",
        "description": "The reply email is the one the person confirmed during authorization. At most 5 enquiries per hour per authorization. Sending an enquiry does not create a lawyer-client relationship.",
        "security": [
          {
            "regulexOAuth": [
              "inquiries:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Inquiry"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Enquiry received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "received"
                      ]
                    },
                    "reply_to": {
                      "type": "string",
                      "format": "email"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Publication": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "type",
          "url"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "datePublished": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "article",
              "newsletter"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "PublicationIndex": {
        "type": "object",
        "properties": {
          "notice": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Publication"
            }
          }
        }
      },
      "ServiceIndex": {
        "type": "object",
        "properties": {
          "notice": {
            "type": "string"
          },
          "contact": {
            "type": "object",
            "properties": {
              "whatsapp": {
                "type": "string",
                "format": "uri"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "Inquiry": {
        "type": "object",
        "required": [
          "name",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "service": {
            "type": "string",
            "enum": [
              "Corporate Structuring",
              "International Arbitration",
              "Commercial Contracts",
              "Legal Drafting",
              "Private Clients",
              "Ongoing Advisory",
              "Other"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 5000
          }
        }
      }
    },
    "securitySchemes": {
      "regulexOAuth": {
        "type": "oauth2",
        "description": "See https://regulex-legal.com/auth.md",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://regulex-legal.com/oauth2/authorize",
            "tokenUrl": "https://regulex-legal.com/oauth2/token",
            "scopes": {
              "inquiries:write": "Send enquiries to REGULEX on behalf of the person who approved"
            }
          }
        }
      }
    }
  }
}
